<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Phases.Umbraco.Community.Catalyst</RootNamespace>
    <AssemblyName>Phases.Umbraco.Community.Catalyst</AssemblyName>

    <!-- Razor Class Library static web assets are served automatically by the
         consuming Umbraco site's own UseStaticFiles/MapStaticAssets pipeline.
         No config, no manual App_Plugins copy, no Program.cs change required. -->
    <StaticWebAssetBasePath>App_Plugins</StaticWebAssetBasePath>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>

    <!-- NuGet Package Metadata -->
    <PackageId>Phases.Umbraco.Community.Catalyst</PackageId>
    <Version>1.0.19</Version>
    <Title>Umbraco Catalyst</Title>
    <Authors>Vishnu Shanmughan, Phases.io</Authors>
    <Company>Phases.io</Company>
    <Product>Umbraco Catalyst</Product>
    <Description>Umbraco Catalyst is a backend-extending package for Umbraco CMS with useful, out-of-the-box property editors and backoffice extensions, including Star Rating, CDN Image, and TipTap Emoji.</Description>
    <PackageTags>umbraco;umbraco-cms;umbraco-backoffice;umbraco-17;umbraco-plugin;umbraco-marketplace;property-editor;data-type;star-rating;rating;cdn-image;image;alt-text;tiptap;rich-text-editor;emoji;emoji-picker;backoffice-extension</PackageTags>
    <PackageProjectUrl>https://github.com/vishnushanmughan/umbraco-catalyst</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vishnushanmughan/umbraco-catalyst</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
    <IncludeSymbols>false</IncludeSymbols>
    <Tags>umbraco-marketplace</Tags> 
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Direct dependency enables Umbraco Marketplace version detection. -->
    <PackageReference Include="Umbraco.Cms.Core" Version="[17.0.0,)" /> 
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[17.0.0,)" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="[10.0.0,)" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="client\**" />
  </ItemGroup>

	<ItemGroup>
		<None Include="icon.png" Pack="true" PackagePath="" />
	</ItemGroup>
	
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
  </ItemGroup>

  <!-- Ensures the backoffice bundle (wwwroot/UmbracoCatalyst) is built before packing -->
  <Target Name="BuildClientBeforePack" BeforeTargets="GenerateNuspec;Pack">
    <PropertyGroup>
      <ClientDir>$(MSBuildThisFileDirectory)client</ClientDir>
    </PropertyGroup>
    <Message Importance="high" Text="Building client assets (npm run build) in $(ClientDir)..." />
    <Exec Command="npm install" WorkingDirectory="$(ClientDir)" Condition="!Exists('$(ClientDir)\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(ClientDir)" IgnoreExitCode="false" />
  </Target>

</Project>
